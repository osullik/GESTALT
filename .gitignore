### gitignore for the GESTALT project 

#Overpass cache files
cache/
scripts/cache/

#Output Files
data/output

#environment files
gestalt_env/
.env
.env.*
!.env.example

# Third-party cloned repos
external/

#Python Stuff to ignore
__pycache__
.ipynb_checkpoints

#LaTeX stuff to ignore: 
*.aux 
*.dvi 
*.log 
*.bbl 
/*.pdf 
*~ 
*.out 
*.blg 
*.nav 
*.toc 
*.snm 
*.fdb_latexmk 
*.fls 
*.synctex.gz 
*.xmpi
*/*.aux 
*/*.dvi 
*/*.log 
*/*.bbl 
*/*~ 
*/*.out 
*/*.blg 
*/*/*~
*.tgz
papers/auto_commit_fig
papers/auto_fig

# Random stuff
.DS_Store

#Image Files
*.jpg
*.jpeg
# Allow the landing page background to be committed despite the *.jpg rule
!ui/public/cover.jpg

# ML Model stuff
*.pt

# Scratch directory checkpoints and PyTorch weights
scratch/**/checkpoints/
scratch/**/*.pt
scratch/**/*.pth
scratch/**/*.ckpt
scratch/**/*.safetensors